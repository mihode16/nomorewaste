# Copier ce fichier en ".env" à la racine du projet et compléter les valeurs avant de lancer
# "docker compose up -d --build" (voir deploy.sh). Le ".env" réel ne doit jamais être commité.

# ---- Base de données ----
MYSQL_ROOT_PASSWORD=change-moi
DB_NAME=nomorewaste
DB_USER=nomorewaste
DB_PASSWORD=change-moi-aussi

# ---- Ports exposés sur la machine hôte ----
HTTP_PORT_HOTE=80
HTTPS_PORT_HOTE=443
API_PORT_HOTE=8081
DB_PORT_HOTE=3307

# ---- URL publique du site (utilisée dans les liens des emails envoyés) ----
SITE_URL=http://localhost

# ---- Email (SMTP Gmail) — rappels de renouvellement d'adhésion + plannings bénévoles ----
# 1. Activer la validation en 2 étapes sur le compte Gmail utilisé pour l'envoi
# 2. Générer un "mot de passe d'application" : https://myaccount.google.com/apppasswords
# 3. Renseigner ce mot de passe ci-dessous (PAS le mot de passe du compte Gmail lui-même)
# Si SMTP_USER/SMTP_PASSWORD sont laissés vides, les emails sont simplement journalisés
# (aucune erreur), pratique pour tester sans configuration SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Heure locale (0-23) d'exécution quotidienne des tâches automatiques ----
SCHEDULER_HEURE=6
